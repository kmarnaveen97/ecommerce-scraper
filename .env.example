APP_ENV=development
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_REDIRECTS=5
HTTP_MAX_RESPONSE_BYTES=10000000
HTTP_VALIDATE_DNS=true
HTTP_USER_AGENT=EcommerceDiscoveryBot/0.1 (+https://github.com/kmarnaveen97/ecommerce-scraper)
MAX_CONCURRENCY=6
TARGET_REQUESTS_PER_SECOND=1.0
TARGET_MAX_CONCURRENCY_PER_HOST=2
TARGET_JITTER_SECONDS=0.25
TARGET_MAX_RETRIES=3
TARGET_BACKOFF_BASE_SECONDS=1
TARGET_BACKOFF_CAP_SECONDS=30
TARGET_MAX_RETRY_AFTER_SECONDS=120
TARGET_BLOCK_THRESHOLD=3
TARGET_CIRCUIT_BREAK_SECONDS=300
ROBOTS_OBEY=true
ROBOTS_USER_AGENT=EcommerceDiscoveryBot
